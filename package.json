{
  "name": "pixelgeselle-demos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "photos": "node scripts/fetchPhotos.mjs",
    "dev:raumton": "yarn workspace @pixelgeselle/raumton dev",
    "dev:phase": "yarn workspace @pixelgeselle/phase dev",
    "dev:firstlinie": "yarn workspace @pixelgeselle/firstlinie dev",
    "dev:ahrens": "yarn workspace @pixelgeselle/ahrens dev",
    "build:raumton": "yarn workspace @pixelgeselle/raumton build",
    "build:phase": "yarn workspace @pixelgeselle/phase build",
    "build:firstlinie": "yarn workspace @pixelgeselle/firstlinie build",
    "build:ahrens": "yarn workspace @pixelgeselle/ahrens build",
    "build": "yarn build:raumton && yarn build:phase && yarn build:firstlinie && yarn build:ahrens && yarn catalog",
    "catalog": "node scripts/buildCatalog.mjs",
    "previews": "node scripts/buildPreviews.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
}
